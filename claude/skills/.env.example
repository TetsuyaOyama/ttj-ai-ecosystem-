# TTJ AIエコシステム：APIキーはこのファイル（実体 ~/.claude/skills/.env）の1か所だけに置く。
# このファイルを .env にコピーして値を入れる（install.sh が自動でコピーします）。
# .env は git 管理外。Claude が直接読まない決まりなので、スクリプトが自分で読み込む。
# 使わないものは空のままでよい。

# Claude API（kuro-discord-bot など）
ANTHROPIC_API_KEY=

# OpenAI（Codex CLI / API）
OPENAI_API_KEY=

# xAI（Grok Bot）。XAI_MODEL は xAI のドキュメントで最新のモデル名を確認して入れる
XAI_API_KEY=
XAI_MODEL=

# Discord（クロBotを作るときに入れる）
DISCORD_BOT_TOKEN=

# Cloudflare Pages（権限：Cloudflare Pages: Edit）
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
